# Resend API Key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Contact form email recipient
CONTACT_EMAIL=your-email@example.com

# Upstash Redis (optional, for rate limiting)
# Get from https://console.upstash.com
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxx

# Site URL (for SEO and redirects)
NEXT_PUBLIC_SITE_URL=https://yourwebsite.com

# MongoDB (required for AI Trends feature)
# Get free tier at https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=portfolio

# AI API Keys (at least one required for AI Trends summarization)
# Anthropic Claude API (recommended, get from https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
# OpenAI API (fallback, get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# Admin API Key (REQUIRED for production - secures admin endpoints)
# Generate a secure random string: openssl rand -hex 32
ADMIN_API_KEY=your-secure-random-api-key-here
